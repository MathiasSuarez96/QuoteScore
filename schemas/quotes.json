      "type": "bool",
      "nullable": true,
      "enum": [],
      "temporal_scope": "initial_requires_evidence"
    },
    "date_flexibility_at_quote": {
      "type": "bool",
      "nullable": true,
      "enum": [],
      "temporal_scope": "initial_requires_evidence"
    },
    "credit_available_at_quote": {
      "type": "bool",
      "nullable": true,
      "enum": [],
      "temporal_scope": "initial_requires_evidence"
    },
    "financing_available_at_quote": {
      "type": "bool",
      "nullable": true,
      "enum": [],
      "temporal_scope": "initial_requires_evidence"
    },
    "source_id": {
      "type": "text",
      "nullable": false,
      "enum": [],
      "temporal_scope": "initial_requires_evidence"
    }
  }
}
