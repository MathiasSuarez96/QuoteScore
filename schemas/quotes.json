    },
    "opportunity_id": {
      "type": "text",
      "nullable": false,
      "enum": [],
      "temporal_scope": "initial_requires_evidence"
    },
    "sent_at": {
      "type": "time",
      "nullable": true,
      "enum": [],
      "temporal_scope": "initial_requires_evidence"
    },
    "date_precision": {
      "type": "text",
      "nullable": false,
      "enum": [
        "day",
        "timestamp",
        "unknown"
      ],
      "temporal_scope": "initial_requires_evidence"
    },
    "version_number": {
      "type": "integer",
      "nullable": true,
      "enum": [],
      "temporal_scope": "initial_requires_evidence"
    },
    "first_priced_quote_status": {
      "type": "text",
      "nullable": false,
      "enum": [
        "confirmed",
        "candidate",
        "unknown"
      ],
